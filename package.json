    "@deck.gl/layers": "9.4.1",
    "@deck.gl/mapbox": "9.4.1",
    "@deck.gl/mesh-layers": "9.4.1",
    "@fastify/static": "10.1.10",
    "@loaders.gl/gltf": "4.5.4",
    "fastify": "5.12.8",
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
